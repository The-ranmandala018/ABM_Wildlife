__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

data/interim/*
data/processed/*
data/reports/*
artifacts/checkpoints/*
artifacts/scalers/*
artifacts/predictions/*
artifacts/metrics/*
artifacts/figures/*

!data/interim/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!artifacts/checkpoints/.gitkeep
!artifacts/scalers/.gitkeep
!artifacts/predictions/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/figures/.gitkeep

# research/ workspace: generated outputs and symlinked feature matrices stay
# on the server only, never pushed to GitHub.
research/results/*
!research/results/.gitkeep
