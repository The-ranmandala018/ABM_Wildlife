__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

data/interim/*
data/processed/*
data/reports/*
artifacts/checkpoints/*
artifacts/scalers/*
artifacts/predictions/*
artifacts/metrics/*
artifacts/figures/*

!data/interim/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!artifacts/checkpoints/.gitkeep
!artifacts/scalers/.gitkeep
!artifacts/predictions/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/figures/.gitkeep

# project_evolution/ workspace: generated outputs and symlinked feature
# matrices stay on the server only by default, never pushed to GitHub.
project_evolution/results/*
!project_evolution/results/.gitkeep

# Exception: small dimensionality-reduction result CSVs, explicitly
# requested to be pushed. The 120D/ symlink (points to the raw feature
# matrix elsewhere on the server) stays excluded.
!project_evolution/results/AlternativeDimensionalityReduction/
!project_evolution/results/AlternativeDimensionalityReduction/**
